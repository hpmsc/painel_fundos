<div id="tip" role="tooltip"></div>

<script>
(function(){
"use strict";
const $ = s => document.querySelector(s);
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const CATS = ["Contábil","Financeiro","Misto","Transferência","Autarquia","Natureza privada","Sem classificação"];
const TIPOS_CLASS = {DEC93872:"dec", BASSI:"bassi", AC1494:"tcu", STNGT:"out", COSTA:"out", SANCHES:"out", SOF2019:"out", PLP22:"out"};
let D = null;
const st = {ano:null, cat:"todos", busca:"", ordem:"atual", aberto:null, limite:40, tipoMarco:"todos", vfFiltro:"", vfBusca:""};

function brl(v, curto){
  if (v === null || v === undefined) return "n/d";
  const a = Math.abs(v);
  const f = (x, d) => x.toLocaleString("pt-BR", {minimumFractionDigits:d, maximumFractionDigits:d});
  if (a >= 1e12) return "R$ " + f(v/1e12, 2) + " tri";
  if (a >= 1e9)  return "R$ " + f(v/1e9, a >= 1e11 ? 0 : 1) + " bi";
  if (a >= 1e6)  return "R$ " + f(v/1e6, a >= 1e8 ? 0 : 1) + " mi";
  if (a >= 1e3)  return "R$ " + f(v/1e3, 0) + " mil";
  return "R$ " + f(v, 0);
}
const pct = (a, b) => (b ? (a / b * 100) : null);
const fpct = p => p === null ? "—" : p.toLocaleString("pt-BR", {maximumFractionDigits:0}) + "%";
const catDe = f => CATS.includes(f.categoria) ? f.categoria : "Sem classificação";
function chipCat(c){ return `<span class="chip ${esc(c)}"><span class="dot"></span>${esc(c)}</span>`; }
function ex(f, ano){ return (f.exec || {})[ano] || null; }

function fundosFiltrados(){
  const q = st.busca.trim().toLowerCase();
  return D.fundos.filter(f => {
    if (st.cat !== "todos" && catDe(f) !== st.cat) return false;
    if (!q) return true;
    const uos = Object.values(f.uos || {}).flat().map(u => u.cod).concat(f.uo_referencia || [], (f.mto?.uos || []).map(u => u.cod));
    const fontes = Object.values(f.fontes || {}).flat().map(x => x.cod).concat(f.fontes_referencia || [], (f.mto?.fontes || []).map(x => x.cod));
    const alvo = [f.sigla, f.nome, f.id, f.cnpj, f.ug, ...uos, ...fontes].join(" ").toLowerCase();
    return alvo.includes(q);
  });
}

/* ---------- tooltip ---------- */
const tip = $("#tip");
document.addEventListener("mousemove", e => {
  const t = e.target.closest("[data-tip]");
  if (!t) { tip.classList.remove("on"); return; }
  tip.innerHTML = t.getAttribute("data-tip");
  tip.classList.add("on");
  const w = tip.offsetWidth, h = tip.offsetHeight;
  let x = e.clientX + 14, y = e.clientY + 14;
  if (x + w > innerWidth - 8) x = e.clientX - w - 14;
  if (y + h > innerHeight - 8) y = e.clientY - h - 14;
  tip.style.left = x + "px"; tip.style.top = y + "px";
});
document.addEventListener("scroll", () => tip.classList.remove("on"), {passive:true});
const tipExec = (nome, e) => esc(`<b>${esc(nome)}</b><br>Dotação <span class="tn">${brl(e.atual)}</span><br>Empenhado <span class="tn">${brl(e.emp)}</span> (${fpct(pct(e.emp, e.atual))})<br>Pago <span class="tn">${brl(e.pago)}</span> (${fpct(pct(e.pago, e.atual))})`);

function trilho(e, max){
  const w = v => (max ? Math.max(0, Math.min(100, (v || 0) / max * 100)) : 0).toFixed(2) + "%";
  return `<div class="trilho"><i class="t-dot" style="width:${w(e.atual)}"></i><i class="t-emp" style="width:${w(e.emp)}"></i><i class="t-pago" style="width:${w(e.pago)}"></i></div>`;
}

/* ---------- cabeçalho, aviso ---------- */
function renderTopo(){
  const g = new Date(D.gerado_em);
  $("#quando").textContent = "Dados montados em " + g.toLocaleDateString("pt-BR") + " · fonte do exercício: " + (D.origem_por_ano[st.ano] || "—");
  const av = $("#aviso");
  if (D.somente_semente) {
    av.innerHTML = `<div class="aviso" role="note"><span aria-hidden="true">⚠</span><div><b>Dados de partida.</b> A coleta pelo orcamentoBR ainda não rodou neste repositório. O exercício de 2018 vem da Tabela 3 de Bassi (2019), com dotação atualizada, empenhado, liquidado e pago por UO (SIAFI/STN). PLOA, LOA inicial, fontes, RP e GND aparecem após a primeira execução do workflow.</div></div>`;
  } else av.innerHTML = "";
}

/* ---------- resumo e KPIs ---------- */
function soma(fs, ano){
  const s = {atual:0, emp:0, pago:0, liq:0, n:0};
  fs.forEach(f => { const e = ex(f, ano); if (!e) return; s.n++; ["atual","emp","pago","liq"].forEach(k => s[k] += e[k] || 0); });
  return s;
}
function renderResumo(fs){
  const s = soma(fs, st.ano);
  const rot = st.cat === "todos" ? "todos os fundos" : st.cat.toLowerCase();
  $("#resumo").innerHTML = `
    <div class="tile"><span>Fundos com execução</span><b>${s.n}</b><small>de ${fs.length} no filtro (${esc(rot)})</small></div>
    <div class="tile"><span><i class="sw" style="background:var(--x-dot)"></i>Dotação atualizada</span><b>${brl(s.atual)}</b><small>LOA + créditos, ${st.ano}</small></div>
    <div class="tile"><span><i class="sw" style="background:var(--x-emp)"></i>Empenhado</span><b>${brl(s.emp)}</b><small>${fpct(pct(s.emp, s.atual))} da dotação</small></div>
    <div class="tile"><span><i class="sw" style="background:var(--x-pago)"></i>Pago</span><b>${brl(s.pago)}</b><small>${fpct(pct(s.pago, s.atual))} da dotação</small></div>`;
}
function renderKPIs(){
  const base = D.fundos;
  const cont = {todos: base.length}; CATS.forEach(c => cont[c] = 0);
  base.forEach(f => cont[catDe(f)]++);
  const btn = (c, rot) => `<button class="kpi" data-cat="${esc(c)}" aria-pressed="${st.cat === c}"><b>${cont[c]}</b><span>${esc(rot)}</span><small>${brl(soma(c === "todos" ? base : base.filter(f => catDe(f) === c), st.ano).atual)}</small></button>`;
  $("#kpis").innerHTML = btn("todos", "Todos os fundos") + CATS.filter(c => cont[c] > 0).map(c => btn(c, c)).join("");
}

/* ---------- ranking ---------- */
function renderRank(fs){
  const it = fs.map(f => ({f, e: ex(f, st.ano)})).filter(x => x.e && x.e.atual > 0).sort((a, b) => b.e.atual - a.e.atual).slice(0, 25);
  const max = it.length ? it[0].e.atual : 0;
  $("#rank").innerHTML = it.length ? it.map(({f, e}) => `<button class="rk-bar" data-abrir="${esc(f.id)}" aria-pressed="${st.aberto === f.id}" data-tip="${tipExec(f.sigla + " · " + f.nome, e)}">
      <span class="rk-lbl">${esc(f.sigla)}</span>${trilho(e, max)}<span class="rk-n">${brl(e.atual)}</span></button>`).join("")
    : `<p class="vazio-serie">Nenhum fundo com dotação em ${st.ano} neste filtro.</p>`;
}

/* ---------- categorias ---------- */
function renderCats(){
  const base = st.busca ? fundosFiltrados() : D.fundos;
  const lin = CATS.map(c => ({c, s: soma(base.filter(f => catDe(f) === c), st.ano)})).filter(x => x.s.n > 0);
  const max = Math.max(0, ...lin.map(x => x.s.atual));
  $("#cats").innerHTML = lin.length ? lin.map(({c, s}) => `<button class="cat-row" data-cat="${esc(c)}" aria-pressed="${st.cat === c}" data-tip="${tipExec(c + " (" + s.n + " fundos)", s)}">
      <div class="cat-l"><b>${chipCat(c)}</b><span>${brl(s.atual)} · ${fpct(pct(s.emp, s.atual))} emp.</span></div>${trilho(s, max)}</button>`).join("")
    : `<p class="vazio-serie">Sem execução em ${st.ano}.</p>`;
}

/* ---------- série histórica ---------- */
function renderSerie(fs){
  const anos = D.anos.slice();
  const pts = anos.map(a => ({a, ...soma(fs, a)}));
  const alvo = $("#serie");
  const unico = st.aberto && fs.length === 1;
  $("#nota-serie").textContent = unico ? `Somente ${fs[0].sigla}, em R$ correntes.` : "Soma dos fundos no filtro atual, em R$ correntes.";
  const max = Math.max(0, ...pts.map(p => p.atual));
  if (!max) { alvo.innerHTML = `<p class="vazio-serie">Sem valores para exibir.</p>`; return; }
  const W = 520, H = 210, L = 58, R = 14, T = 12, B = 26;
  const nice = v => { const p = Math.pow(10, Math.floor(Math.log10(v))); const m = v / p; return (m <= 1 ? 1 : m <= 2 ? 2 : m <= 2.5 ? 2.5 : m <= 5 ? 5 : 10) * p; };
  const top = nice(max), ticks = [0, .25, .5, .75, 1].map(k => k * top);
  const x = i => anos.length === 1 ? (L + (W - L - R) / 2) : L + i * (W - L - R) / (anos.length - 1);
  const y = v => T + (H - T - B) * (1 - v / top);
  const linha = (k, cor, dash) => pts.length > 1 ? `<path d="${pts.map((p, i) => (i ? "L" : "M") + x(i).toFixed(1) + " " + y(p[k]).toFixed(1)).join(" ")}" fill="none" stroke="${cor}" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" ${dash ? 'stroke-dasharray="5 4"' : ""}/>` : "";
  const pontos = (k, cor) => pts.map((p, i) => `<circle cx="${x(i).toFixed(1)}" cy="${y(p[k]).toFixed(1)}" r="${pts.length > 1 ? 3 : 4.5}" fill="${cor}" stroke="var(--surface)" stroke-width="2"/>`).join("");
  const passo = Math.max(1, Math.ceil(anos.length / 8));
  const hit = pts.map((p, i) => { const w = anos.length > 1 ? (W - L - R) / (anos.length - 1) : 60;
      return `<rect x="${(x(i) - w / 2).toFixed(1)}" y="${T}" width="${w.toFixed(1)}" height="${H - T - B}" fill="transparent" data-tip="${tipExec(String(p.a) + " · " + p.n + " fundos", p)}"/>`; }).join("");
  const ult = pts[pts.length - 1];
  alvo.innerHTML = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Série histórica de dotação, empenho e pagamento">
    ${ticks.map(t => `<line class="grade" x1="${L}" x2="${W - R}" y1="${y(t).toFixed(1)}" y2="${y(t).toFixed(1)}"/><text x="${L - 6}" y="${(y(t) + 3.5).toFixed(1)}" text-anchor="end">${esc(brl(t).replace("R$ ", ""))}</text>`).join("")}
    <line class="eixo" x1="${L}" x2="${W - R}" y1="${H - B}" y2="${H - B}"/>
    ${anos.map((a, i) => (i % passo === 0 || i === anos.length - 1) ? `<text x="${x(i).toFixed(1)}" y="${H - 8}" text-anchor="middle">${a}</text>` : "").join("")}
    ${linha("atual", "var(--l-dot)", true)}${linha("emp", "var(--l-emp)")}${linha("pago", "var(--l-pago)")}
    ${pontos("atual", "var(--l-dot)")}${pontos("emp", "var(--l-emp)")}${pontos("pago", "var(--l-pago)")}
    ${hit}
  </svg>` + (anos.length === 1 ? `<p class="vazio-serie">Só há um exercício na base (${anos[0]}). A série de 2014 em diante chega com a coleta pelo orcamentoBR.</p>`
      : `<p class="vazio-serie">Último exercício: dotação ${brl(ult.atual)}, empenhado ${brl(ult.emp)}, pago ${brl(ult.pago)}.</p>`);
}

/* ---------- identificação composta ---------- */
function renderIdents(fs){
  const orc = fs.filter(f => !/fora do OGU|privad/i.test(f.no_orcamento + " " + f.natureza_juridica));
  const n = orc.length || 1;
  const temUO = orc.filter(f => Object.keys(f.uos || {}).length || (f.mto?.uos || []).length || (f.uo_referencia || []).length).length;
  const temFonte = orc.filter(f => Object.keys(f.fontes || {}).length || (f.mto?.fontes || []).length || (f.fontes_referencia || []).length).length;
  const temUG = orc.filter(f => f.ug).length, temCNPJ = orc.filter(f => f.cnpj).length;
  const card = (t, p, k, orig) => `<div class="idc"><h3>${t}</h3><p>${p}</p><div class="cob">${k} de ${orc.length} fundos · ${orig}</div><div class="barra-cob"><i style="width:${(k / n * 100).toFixed(1)}%"></i></div></div>`;
  $("#idents").innerHTML =
    card("Unidade Orçamentária (UO)", "Identificador orçamentário primário, com 5 dígitos. Nos fundos especiais, o 3º dígito é 9 (36901 FNS, 24901 FNDCT). A parte financeira fica em UOs 749xx, de Operações Oficiais de Crédito.", temUO, "SIOP e MTO 2026") +
    card("Fonte de recursos", "Vinculação legal e origem do dinheiro: 1º dígito é o grupo e os três seguintes a especificação (044 = Fistel destinado ao Fust; 068 = FNDF).", temFonte, "SIOP e MTO 2026") +
    card("UG e Gestão (SIAFI)", "Unidade gestora que executa a despesa e a contabilidade do fundo. Não sai do SIOP; registre em <code>fundos.csv</code>.", temUG, "cadastro manual") +
    card("CNPJ próprio", "Exigido pela IN RFB 2.119/2022 para identificação fiscal e bancária. Não confere personalidade jurídica.", temCNPJ, "cadastro manual");
}

/* ---------- lista de fundos ---------- */
function ordenar(fs){
  const a = st.ano, v = f => ex(f, a);
  if (st.ordem === "sigla") return fs.slice().sort((x, y) => x.sigla.localeCompare(y.sigla, "pt-BR"));
  if (st.ordem === "exec") return fs.slice().sort((x, y) => {
    const px = v(x) && v(x).atual ? v(x).emp / v(x).atual : 9, py = v(y) && v(y).atual ? v(y).emp / v(y).atual : 9; return px - py; });
  return fs.slice().sort((x, y) => ((v(y) || {}).atual || 0) - ((v(x) || {}).atual || 0) || x.sigla.localeCompare(y.sigla, "pt-BR"));
}
function uosDoFundo(f){
  const doAno = (f.uos || {})[st.ano];
  if (doAno && doAno.length) return {cods: doAno.map(u => u.cod), orig: (String(D.origem_por_ano[st.ano] || "").startsWith("SIOP") ? "SIOP " : "Bassi ") + st.ano};
  if ((f.mto?.uos || []).length) return {cods: f.mto.uos.map(u => u.cod), orig: "MTO 2026"};
  if ((f.uo_referencia || []).length) return {cods: f.uo_referencia, orig: "cadastro"};
  return {cods: [], orig: ""};
}
function fontesDoFundo(f){
  const doAno = (f.fontes || {})[st.ano];
  if (doAno && doAno.length) return {cods: doAno.slice(0, 4).map(x => x.cod), extra: doAno.length - 4, orig: "SIOP"};
  const m = (f.mto?.fontes || []).filter(x => x.vinculo === "explícito").map(x => x.cod);
  const cods = [...new Set(m.concat(f.fontes_referencia || []))];
  return {cods: cods.slice(0, 4), extra: cods.length - 4, orig: cods.length ? "MTO 2026" : ""};
}
function linhaFundo(f, max){
  const e = ex(f, st.ano);
  const u = uosDoFundo(f), fo = fontesDoFundo(f);
  const naturais = [];
  if (f.natureza_juridica && !/^Fundo especial$/.test(f.natureza_juridica)) naturais.push(`<span class="chip tipo">${esc(f.natureza_juridica)}</span>`);
  if (!f.cadastrado) naturais.push(`<span class="chip warn">sem cadastro</span>`);
  const ids = `<p class="ids">
      <span>UO ${u.cods.length ? `<b>${u.cods.map(esc).join(" · ")}</b> <small>(${esc(u.orig)})</small>` : `<span class="falta">sem UO própria</span>`}</span>
      <span>Fonte ${fo.cods.length ? `<b>${fo.cods.map(esc).join(" · ")}${fo.extra > 0 ? " +" + fo.extra : ""}</b>` : `<span class="falta">—</span>`}</span>
      <span>UG ${f.ug ? `<b>${esc(f.ug)}</b>` : `<span class="falta">a registrar</span>`}</span>
      <span>CNPJ ${f.cnpj ? `<b>${esc(f.cnpj)}</b>` : `<span class="falta">a registrar</span>`}</span></p>`;
  const val = e ? `${trilho(e, e.atual)}<dl><dt>Dotação</dt><dd>${brl(e.atual)}</dd><dt>Empenhado</dt><dd>${brl(e.emp)} <small>${fpct(pct(e.emp, e.atual))}</small></dd><dt>Pago</dt><dd>${brl(e.pago)} <small>${fpct(pct(e.pago, e.atual))}</small></dd></dl>`
    : `<span class="nd">Sem execução própria em ${st.ano}${(f.exec_fonte || {})[st.ano] ? " · fonte vinculada: " + brl(f.exec_fonte[st.ano].atual) : ""}</span>`;
  const aberto = st.aberto === f.id;
  return `<div class="item${aberto ? " aberto" : ""}" id="f-${esc(f.id)}">
    <button class="linha" data-abrir="${esc(f.id)}" aria-expanded="${aberto}">
      <div><span class="ls"><span class="seta" aria-hidden="true">▶</span>${esc(f.sigla)}</span><div class="lm">${chipCat(catDe(f))}${naturais.join("")}</div></div>
      <div><p class="ln">${esc(f.nome)}</p>${ids}</div>
      <div class="lv">${val}</div>
    </button>
    ${aberto ? detalhe(f) : ""}
  </div>`;
}
function renderLista(fs){
  const ord = ordenar(fs);
  const max = Math.max(0, ...ord.map(f => (ex(f, st.ano) || {}).atual || 0));
  const vis = ord.slice(0, st.limite);
  if (st.aberto && !vis.find(f => f.id === st.aberto)) { const a = ord.find(f => f.id === st.aberto); if (a) vis.push(a); }
  $("#cont").textContent = `${fs.length} fundo${fs.length === 1 ? "" : "s"}`;
  $("#lista").innerHTML = vis.length ? vis.map(f => linhaFundo(f, max)).join("") + (ord.length > vis.length ? `<button class="mais" id="mais">Mostrar mais ${Math.min(40, ord.length - vis.length)} de ${ord.length - vis.length}</button>` : "")
    : `<div class="vazio">Nenhum fundo encontrado. Tente outra sigla, código de UO ou fonte.</div>`;
}

/* ---------- detalhe do fundo ---------- */
function nomeMarco(id){ const m = D.marcos.find(x => x.id === id); return m ? m : {titulo:id, ano:""}; }
function detalhe(f){
  const anos = Object.keys(f.exec || {}).sort();
  const execTab = anos.length ? `<div class="rolagem"><table class="t"><thead><tr><th>Ano</th><th>PLOA</th><th>LOA</th><th>Dotação atual.</th><th>Empenhado</th><th>Liquidado</th><th>Pago</th><th>Emp./dot.</th></tr></thead><tbody>
      ${anos.map(a => { const e = f.exec[a]; return `<tr><td>${a}</td><td>${brl(e.ploa)}</td><td>${brl(e.loa)}</td><td>${brl(e.atual)}</td><td>${brl(e.emp)}</td><td>${brl(e.liq)}</td><td>${brl(e.pago)}</td><td>${fpct(pct(e.emp, e.atual))}</td></tr>`; }).join("")}
    </tbody></table></div>` : `<p class="vazio-serie">Sem execução própria registrada na base.</p>`;

  const hist = (f.historico_uo || []).map(h => `<span class="chip">${esc(h.desde)}: ${h.uos.map(esc).join(" + ")}</span>`).join(" ");
  const uosAno = ((f.uos || {})[st.ano] || []).map(u => `<div>${esc(u.cod)} · ${esc(u.desc)} <small class="mono" style="color:var(--muted)">(${esc(u.dimensao)}${u.categoria_bassi ? "; Bassi: " + esc(u.categoria_bassi) : ""})</small></div>`).join("");
  const mtoU = (f.mto?.uos || []).map(u => `${esc(u.cod)}${u.sigla ? " " + esc(u.sigla) : ""}`).join(" · ");
  const ident = `<dl class="kv">
      <dt>UO em ${st.ano}</dt><dd>${uosAno || '<span class="nd" style="color:var(--muted)">—</span>'}</dd>
      <dt>UO no MTO 2026</dt><dd class="mono">${mtoU || "—"}</dd>
      <dt>Histórico de UO</dt><dd>${hist || "—"}</dd>
      <dt>UG / Gestão</dt><dd>${f.ug ? esc(f.ug) : "a registrar no cadastro"}</dd>
      <dt>CNPJ</dt><dd>${f.cnpj ? esc(f.cnpj) : "a registrar no cadastro"}</dd>
      <dt>Natureza</dt><dd>${esc(f.natureza_juridica || "—")}</dd>
      <dt>No orçamento</dt><dd>${esc(f.no_orcamento || "—")}</dd>
      ${f.observacao ? `<dt>Nota</dt><dd>${esc(f.observacao)}</dd>` : ""}
    </dl>`;

  const fon = (f.fontes || {})[st.ano] || [];
  const maxF = Math.max(0, ...fon.map(x => x.atual));
  const fontesObs = fon.length ? `<div class="mini">${fon.slice(0, 10).map(x => `<div class="ml" data-tip="${esc(`<b>Fonte ${esc(x.cod)}</b><br>${esc(x.desc)}<br>Dotação <span class="tn">${brl(x.atual)}</span> · Empenhado <span class="tn">${brl(x.emp)}</span>`)}"><span><b class="mono">${esc(x.cod)}</b> ${esc(x.desc)}</span>${trilho(x, maxF)}</div>`).join("")}</div>`
    : `<p class="vazio-serie">Fontes por fundo chegam com a coleta pelo orcamentoBR.</p>`;
  const mtoF = (f.mto?.fontes || []).map(x => `<div><b class="mono">${esc(x.cod)}</b> ${esc(x.desc)} <span class="chip ${x.vinculo === "explícito" ? "ok" : "warn"}">${esc(x.vinculo)}</span></div>`).join("");
  const mtoR = (f.mto?.receitas || []).map(x => `<div><b class="mono">${esc(x.cod)}</b> ${esc(x.desc)}</div>`).join("");

  const rp = ((f.rp || {})[st.ano] || []), gnd = ((f.gnd || {})[st.ano] || []);
  const maxR = Math.max(0, ...rp.map(x => x.atual)), maxG = Math.max(0, ...gnd.map(x => x.atual));
  const bar = (x, m) => `<div class="ml" data-tip="${esc(`<b>${esc(x.cod)} · ${esc(x.desc)}</b><br>Dotação <span class="tn">${brl(x.atual)}</span><br>Empenhado <span class="tn">${brl(x.emp)}</span>`)}"><span><b class="mono">${esc(x.cod)}</b> ${esc(x.desc)}</span>${trilho(x, m)}</div>`;

  const cls = (f.classificacoes || []).slice().sort((a, b) => String(nomeMarco(a.marco).ano).localeCompare(String(nomeMarco(b.marco).ano)));
  const tl = cls.length ? `<ol class="tl">${cls.map(c => { const m = nomeMarco(c.marco); return `<li><span class="a">${esc(m.ano)}</span><div><div class="c">${chipCat(c.classificacao)}<em>${esc(m.titulo)}</em></div>${c.detalhe ? `<span class="r">${esc(c.detalhe)}</span>` : ""}<span class="r">ET 01/2026: ${esc(c.ref)}</span></div></li>`; }).join("")}</ol>`
    : `<p class="vazio-serie">O ET 01/2026 não classifica este fundo.</p>`;

  const ef = f.exec_fonte || {};
  const efAnos = Object.keys(ef).sort();
  const vfont = efAnos.length ? `<div class="rolagem"><table class="t"><thead><tr><th>Ano</th><th>Dotação das fontes</th><th>Empenhado</th><th>Nas UOs do fundo</th></tr></thead><tbody>${efAnos.map(a => `<tr><td>${a}</td><td>${brl(ef[a].atual)}</td><td>${brl(ef[a].emp)}</td><td>${fpct(pct(ef[a].dentro, ef[a].atual))}</td></tr>`).join("")}</tbody></table></div>`
    : `<p class="vazio-serie">O cruzamento fonte × UO (2023 em diante) chega com a coleta.</p>`;

  return `<div class="det">
    <div class="bloco"><h4>Identificação composta</h4>${ident}</div>
    <div class="bloco"><h4>Histórico de classificações</h4>${tl}</div>
    <div class="bloco largo"><h4>Execução por exercício</h4>${execTab}</div>
    <div class="bloco"><h4>Fontes executadas em ${st.ano}</h4>${fontesObs}</div>
    <div class="bloco"><h4>Códigos no MTO 2026</h4>${mtoF || mtoR ? `<div class="mini" style="font-size:12px">${mtoF}${mtoR ? `<div style="margin-top:6px;color:var(--muted)">Naturezas de receita:</div>${mtoR}` : ""}</div>` : `<p class="vazio-serie">Nenhuma fonte ou natureza de receita do MTO 2026 cita este fundo.</p>`}</div>
    <div class="bloco"><h4>Resultado primário ${st.ano}</h4>${rp.length ? `<div class="mini">${rp.map(x => bar(x, maxR)).join("")}</div>` : `<p class="vazio-serie">Disponível após a coleta.</p>`}</div>
    <div class="bloco"><h4>Grupo de natureza da despesa ${st.ano}</h4>${gnd.length ? `<div class="mini">${gnd.map(x => bar(x, maxG)).join("")}</div>` : `<p class="vazio-serie">Disponível após a coleta. GND 5 (inversões financeiras) indica operação de crédito.</p>`}</div>
    <div class="bloco largo"><h4>Fontes do MTO ligadas ao fundo: onde são executadas</h4>${vfont}</div>
  </div>`;
}

/* ---------- histórico de classificações ---------- */
function renderMatriz(fs){
  const com = fs.filter(f => (f.classificacoes || []).length);
  const col = (f, ids) => (f.classificacoes || []).filter(c => ids.includes(c.marco));
  const cel = (arr, mostraMarco) => arr.length ? arr.map(c => `<span data-tip="${esc(`<b>${esc(nomeMarco(c.marco).titulo)}</b><br>${esc(c.detalhe || c.classificacao)}<br>ET 01/2026: ${esc(c.ref)}`)}">${chipCat(mostraMarco ? c.classificacao + " · " + nomeMarco(c.marco).ano : c.classificacao)}</span>`).join("") : `<span style="color:var(--muted)">—</span>`;
  const outrosIds = D.marcos.map(m => m.id).filter(id => !["DEC93872","BASSI","AC1494","STNGT","COSTA"].includes(id));
  $("#matriz").innerHTML = com.length ? `<thead><tr><th>Fundo</th><th>Decreto 93.872/1986<br>(contábil × financeiro)</th><th>Bassi 2019</th><th>TCU 1.494/2021</th><th>STN 2011 · Costa 2017</th><th>Normas e controle posteriores</th></tr></thead><tbody>
    ${com.map(f => `<tr><td><button class="rk-bar" style="display:inline;width:auto;grid-template-columns:none" data-abrir="${esc(f.id)}"><span class="rk-lbl">${esc(f.sigla)}</span></button></td>
      <td>${cel(col(f, ["DEC93872"]))}</td><td>${cel(col(f, ["BASSI"]))}</td><td>${cel(col(f, ["AC1494"]))}</td><td>${cel(col(f, ["STNGT","COSTA"]))}</td><td>${cel(col(f, outrosIds), true)}</td></tr>`).join("")}</tbody>`
    : `<tbody><tr><td class="txt">Nenhum fundo classificado no filtro atual.</td></tr></tbody>`;
}
function renderTempo(){
  const tipos = [...new Set(D.marcos.map(m => m.tipo.split(" (")[0]))];
  $("#filtro-tipos").innerHTML = ["todos", ...tipos].map(t => `<button data-tipo="${esc(t)}" aria-pressed="${st.tipoMarco === t}">${t === "todos" ? "Todos" : esc(t)}</button>`).join("");
  const porMarco = {};
  D.fundos.forEach(f => (f.classificacoes || []).forEach(c => (porMarco[c.marco] = porMarco[c.marco] || []).push(f)));
  const ms = D.marcos.filter(m => st.tipoMarco === "todos" || m.tipo.startsWith(st.tipoMarco)).slice().sort((a, b) => String(a.ano).localeCompare(String(b.ano)));
  $("#tempo").innerHTML = ms.map(m => { const fs = porMarco[m.id] || [];
    return `<li class="${m.tipo.startsWith("Taxonomia") ? "Taxonomia" : ""}"><span class="ano">${esc(m.ano)}</span><div><h3>${esc(m.titulo)}</h3><p>${esc(m.descricao)}</p>
      <div class="meta"><span class="chip tipo">${esc(m.tipo)}</span><span class="ref">ET 01/2026 · ${esc(m.ref_et)}</span>${fs.length ? " " + fs.slice(0, 14).map(f => `<button class="chip" style="cursor:pointer" data-abrir="${esc(f.id)}">${esc(f.sigla)}</button>`).join("") + (fs.length > 14 ? ` <span class="ref">+${fs.length - 14}</span>` : "") : ""}</div></div></li>`; }).join("");
}

/* ---------- verificação MTO ---------- */
function renderMTO(){
  const vmap = {}; (D.verificacao_fontes || []).forEach(v => vmap[v.cod] = v);
  const sig = id => { const f = D.fundos.find(x => x.id === id); return f ? f.sigla : id; };
  const q = st.vfBusca.trim().toLowerCase();
  const rows = (D.mto?.fontes || []).filter(r => (!st.vfFiltro || r.vinculo.startsWith(st.vfFiltro)) &&
    (!q || (r.fonte_cod + " " + r.descricao + " " + r.fundo_id.split("|").map(sig).join(" ") + " " + r.fundo_id).toLowerCase().includes(q)));
  $("#vf-cont").textContent = `${rows.length} fontes`;
  const statusChip = s => ({"confirmado":"ok","parcial":"warn","fora das UOs do fundo":"bad"}[s] || "");
  $("#vf").innerHTML = `<thead><tr><th>Fonte</th><th>Descrição (MTO 2026)</th><th>Fundo</th><th>Vínculo</th><th>Execução observada</th></tr></thead><tbody>
    ${rows.map(r => { const v = vmap[r.fonte_cod]; let ex = `<span style="color:var(--muted)">aguardando coleta</span>`;
      if (v) { const anos = Object.keys(v.anos).sort(); const a = v.anos[st.ano] ? st.ano : anos[anos.length - 1]; const va = v.anos[a];
        const top = va.uos.slice(0, 5).map(u => `${esc(u.uo)} ${esc(u.desc)}: ${brl(u.atual)}${u.fundo_uo ? " (" + esc(sig(u.fundo_uo)) + ")" : ""}`).join("<br>");
        ex = `<span class="status" data-tip="${esc(`<b>Fonte ${esc(r.fonte_cod)} em ${a}</b><br>Dotação total ${brl(va.atual)}<br>${top}`)}"><span class="chip ${statusChip(va.status)}">${esc(va.status)}</span><span class="mono">${fpct(va.dentro_pct)} · ${a}</span></span>`; }
      return `<tr><td class="mono">${esc(r.fonte_cod)}</td><td class="txt">${esc(r.descricao)}${r.justificativa ? `<br><small style="color:var(--muted)">${esc(r.justificativa)}</small>` : ""}</td>
        <td class="txt">${r.fundo_id ? r.fundo_id.split("|").map(id => `<button class="chip" style="cursor:pointer" data-abrir="${esc(id)}">${esc(sig(id))}</button>`).join(" ") : "—"}</td>
        <td class="txt"><span class="chip ${r.vinculo === "explícito" ? "ok" : "warn"}">${esc(r.vinculo)}</span></td><td class="txt">${ex}</td></tr>`; }).join("")}</tbody>`;
  const uos = D.mto?.uos_de_fundo || [];
  $("#mto-uos").innerHTML = `<thead><tr><th>UO</th><th>Descrição</th><th>Fundo</th></tr></thead><tbody>${uos.map(u => `<tr><td>${esc(u.uo_cod)}</td><td class="txt">${esc(u.descricao)}${u.sigla ? ` <small class="mono" style="color:var(--muted)">${esc(u.sigla)}</small>` : ""}</td><td class="txt">${u.fundo_id ? `<button class="chip" style="cursor:pointer" data-abrir="${esc(u.fundo_id)}">${esc(sig(u.fundo_id))}</button>` : "—"}</td></tr>`).join("")}</tbody>`;
  const rec = D.mto?.receitas || [];
  $("#mto-rec").innerHTML = `<thead><tr><th>Natureza</th><th>Descrição</th><th>Fundo</th></tr></thead><tbody>${rec.map(r => `<tr><td>${esc(r.natureza_cod)}</td><td class="txt">${esc(r.descricao)}</td><td class="txt">${r.fundo_id ? r.fundo_id.split("|").map(id => `<button class="chip" style="cursor:pointer" data-abrir="${esc(id)}">${esc(sig(id))}</button>`).join(" ") : "—"}</td></tr>`).join("")}</tbody>`;
}

/* ---------- orquestração ---------- */
function render(){
  const fs = fundosFiltrados();
  const fsSerie = st.aberto ? D.fundos.filter(f => f.id === st.aberto) : fs;
  renderTopo(); renderResumo(fs); renderKPIs(); renderRank(fs); renderCats(); renderSerie(fsSerie);
  renderIdents(fs); renderLista(fs); renderMatriz(fs); renderTempo(); renderMTO();
}
function abrir(id, rolar){
  st.aberto = st.aberto === id ? null : id;
  if (st.aberto) { const f = D.fundos.find(x => x.id === id); if (f && st.cat !== "todos" && catDe(f) !== st.cat) st.cat = "todos"; if (f && st.busca && !fundosFiltrados().includes(f)) { st.busca = ""; $("#busca").value = ""; } }
  render();
  if (st.aberto && rolar) { const el = document.getElementById("f-" + id); if (el) el.scrollIntoView({behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block:"start"}); }
}
document.addEventListener("click", e => {
  const ab = e.target.closest("[data-abrir]");
  if (ab) { const naLista = !!ab.closest("#lista"); abrir(ab.getAttribute("data-abrir"), !naLista); return; }
  const k = e.target.closest("[data-cat]");
  if (k) { const c = k.getAttribute("data-cat"); st.cat = (st.cat === c && c !== "todos") ? "todos" : c; st.limite = 40; render(); return; }
  const t = e.target.closest("[data-tipo]");
  if (t) { st.tipoMarco = t.getAttribute("data-tipo"); renderTempo(); return; }
  if (e.target.id === "mais") { st.limite += 40; renderLista(fundosFiltrados()); }
});
let tb; $("#busca").addEventListener("input", e => { clearTimeout(tb); tb = setTimeout(() => { st.busca = e.target.value; st.limite = 40; render(); }, 160); });
$("#ordem").addEventListener("change", e => { st.ordem = e.target.value; renderLista(fundosFiltrados()); });
$("#ano").addEventListener("change", e => { st.ano = e.target.value; render(); });
$("#vf-filtro").addEventListener("change", e => { st.vfFiltro = e.target.value; renderMTO(); });
let tv; $("#vf-busca").addEventListener("input", e => { clearTimeout(tv); tv = setTimeout(() => { st.vfBusca = e.target.value; renderMTO(); }, 160); });

fetch("dados.json", {cache: "no-cache"}).then(r => { if (!r.ok) throw new Error(r.status); return r.json(); }).then(d => {
  D = d;
  const anos = D.anos.map(String);
  st.ano = anos[anos.length - 1] || String(new Date().getFullYear());
  $("#ano").innerHTML = anos.slice().reverse().map(a => `<option value="${a}">${a}</option>`).join("");
  $("#ano").value = st.ano;
  if (location.hash.length > 1) { const id = decodeURIComponent(location.hash.slice(1)); if (D.fundos.find(f => f.id === id)) st.aberto = id; }
  render();
}).catch(err => {
  $("#quando").textContent = "Não foi possível carregar dados.json";
  $("#aviso").innerHTML = `<div class="aviso" role="alert"><div><b>Os dados não carregaram.</b> Confira se <code>site/dados.json</code> existe (rode <code>python3 montar.py</code>) e se a página está sendo servida por HTTP, não aberta direto do disco. Detalhe: ${esc(err.message)}</div></div>`;
});
})();
</script>
</body>
</html>
