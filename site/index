<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Fundos Públicos da União</title>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Public+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{
  color-scheme:light;
  --paper:#eaeeec; --surface:#fff; --surface-2:#f4f7f6;
  --ink:#131f1c; --ink-2:#3e504b; --muted:#66756f;
  --line:#ccd6d2; --line-2:#e3e9e7;
  --petrol:#0e4a44; --petrol-2:#12645b; --amber:#9a5a06; --amber-bg:#f8ecd6; --amber-line:#e3c894; --amber-ink:#5b3a06;
  --ok:#0e6b4f; --ok-bg:#e2f2ec; --warn:#8a5a00; --warn-bg:#fbf0d9; --bad:#8a2e26; --bad-bg:#fbeeec;
  --c-cont:#2a78d6; --c-fin:#eb6834; --c-misto:#1baf7a; --c-out:#8a948f;
  --x-dot:#b7d3f6; --x-emp:#2a78d6; --x-pago:#104281;
  --l-dot:#6da7ec; --l-emp:#2a78d6; --l-pago:#104281;
  --r:10px; --shadow:0 1px 2px rgba(19,31,28,.05), 0 10px 26px -18px rgba(19,31,28,.3);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    color-scheme:dark;
    --paper:#0e1513; --surface:#151f1c; --surface-2:#1b2724;
    --ink:#e5eeeb; --ink-2:#b4c3be; --muted:#8a9a94;
    --line:#2d3b37; --line-2:#23302c;
    --petrol:#6cc0b4; --petrol-2:#8fd3c9; --amber:#e3a74d; --amber-bg:#2c2313; --amber-line:#5b4520; --amber-ink:#f0d3a0;
    --ok:#5fc79f; --ok-bg:#15302a; --warn:#e0b24f; --warn-bg:#2d2513; --bad:#ec8a80; --bad-bg:#321c1a;
    --c-cont:#3987e5; --c-fin:#d95926; --c-misto:#199e70; --c-out:#6f7a75;
    --x-dot:#1f3f66; --x-emp:#3987e5; --x-pago:#9ec5f4;
    --l-dot:#256abf; --l-emp:#5598e7; --l-pago:#b7d3f6;
    --shadow:0 1px 2px rgba(0,0,0,.3), 0 10px 26px -18px rgba(0,0,0,.6);
  }
}
:root[data-theme="dark"]{
  color-scheme:dark;
  --paper:#0e1513; --surface:#151f1c; --surface-2:#1b2724;
  --ink:#e5eeeb; --ink-2:#b4c3be; --muted:#8a9a94;
  --line:#2d3b37; --line-2:#23302c;
  --petrol:#6cc0b4; --petrol-2:#8fd3c9; --amber:#e3a74d; --amber-bg:#2c2313; --amber-line:#5b4520; --amber-ink:#f0d3a0;
  --ok:#5fc79f; --ok-bg:#15302a; --warn:#e0b24f; --warn-bg:#2d2513; --bad:#ec8a80; --bad-bg:#321c1a;
  --c-cont:#3987e5; --c-fin:#d95926; --c-misto:#199e70; --c-out:#6f7a75;
  --x-dot:#1f3f66; --x-emp:#3987e5; --x-pago:#9ec5f4;
  --l-dot:#256abf; --l-emp:#5598e7; --l-pago:#b7d3f6;
  --shadow:0 1px 2px rgba(0,0,0,.3), 0 10px 26px -18px rgba(0,0,0,.6);
}
*{box-sizing:border-box}
html,body{background:var(--paper)}
body{margin:0; color:var(--ink); font-family:"Public Sans",system-ui,-apple-system,"Segoe UI",sans-serif; font-size:15px; line-height:1.55; -webkit-font-smoothing:antialiased}
h1,h2,h3{font-family:"Bricolage Grotesque","Public Sans",system-ui,sans-serif; margin:0; letter-spacing:-.02em; text-wrap:balance}
a{color:var(--petrol)}
a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,[tabindex]:focus-visible{outline:2px solid var(--petrol); outline-offset:2px}
.wrap{max-width:1180px; margin:0 auto; padding-inline:20px}
.mono,.num{font-family:"JetBrains Mono",ui-monospace,"SFMono-Regular",Menlo,monospace; font-variant-numeric:tabular-nums}
.eyebrow{font-family:"JetBrains Mono",ui-monospace,monospace; font-size:10.5px; letter-spacing:.14em; text-transform:uppercase; color:var(--muted); margin:0}
.sr{position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0)}

header{background:var(--surface); border-bottom:1px solid var(--line)}
.hd{display:flex; flex-wrap:wrap; gap:14px 24px; justify-content:space-between; align-items:flex-end; padding-block:18px}
.hd > div:first-child{flex:1 1 520px; min-width:0}
.hd h1{font-size:25px; font-weight:800}
.hd p{margin:2px 0 0; font-size:13.5px; color:var(--ink-2); max-width:68ch}
.hd-dir{display:flex; flex-direction:column; align-items:flex-end; gap:6px; flex:0 1 300px}
.quando{font-family:"JetBrains Mono",ui-monospace,monospace; font-size:11.5px; color:var(--muted); text-align:right; margin:0}
.ano-sel{display:flex; align-items:center; gap:8px; font-size:12.5px; color:var(--ink-2)}
select,input{font:inherit; font-size:13.5px; background:var(--surface); border:1px solid var(--line); border-radius:8px; padding:7px 10px; color:var(--ink)}

.aviso{display:flex; gap:10px; padding:11px 14px; margin:16px 0 0; border-radius:var(--r); background:var(--amber-bg); border:1px solid var(--amber-line); font-size:13px; color:var(--amber-ink)}
.aviso b{font-weight:600}

.resumo{display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:10px; padding-top:22px}
.tile{background:var(--surface); border:1px solid var(--line); border-radius:var(--r); padding:12px 14px; box-shadow:var(--shadow)}
.tile span{display:block; font-size:12px; font-weight:600; color:var(--ink-2)}
.tile b{display:block; font-family:"JetBrains Mono",ui-monospace,monospace; font-size:22px; font-weight:600; letter-spacing:-.04em; line-height:1.2; margin-top:3px}
.tile small{display:block; font-size:11.5px; color:var(--muted); margin-top:2px}
.tile .sw{display:inline-block; width:9px; height:9px; border-radius:2px; margin-right:6px; vertical-align:0}

.kpis{display:flex; flex-wrap:nowrap; gap:8px; padding-top:12px; overflow-x:auto; scrollbar-width:thin; padding-bottom:4px}
.kpi{flex:1 1 0; min-width:104px; background:var(--surface); border:1px solid var(--line); border-top:3px solid var(--line);
  border-radius:var(--r); padding:8px 11px; box-shadow:var(--shadow); text-align:left; font:inherit; color:var(--ink); cursor:pointer}
.kpi[aria-pressed="true"]{background:var(--surface-2); border-color:var(--ink-2)}
.kpi b{font-family:"JetBrains Mono",ui-monospace,monospace; font-size:19px; font-weight:600; line-height:1.1; display:block; letter-spacing:-.04em}
.kpi span{display:block; font-size:11.5px; font-weight:600; margin-top:3px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
.kpi small{display:block; font-size:10.5px; color:var(--muted); font-family:"JetBrains Mono",ui-monospace,monospace}
.kpi[data-cat="Contábil"]{border-top-color:var(--c-cont)}
.kpi[data-cat="Financeiro"]{border-top-color:var(--c-fin)}
.kpi[data-cat="Misto"]{border-top-color:var(--c-misto)}
.kpi[data-cat="todos"]{border-top-color:var(--ink-2)}

section{padding-top:32px}
section > h2{font-size:19px}
.sub{margin:3px 0 14px; color:var(--muted); font-size:13.5px; max-width:80ch}

.grid3{display:grid; grid-template-columns:1.15fr 1fr 1.25fr; gap:14px}
.grid2{display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px}
.grid4{display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:10px}
.painel{background:var(--surface); border:1px solid var(--line); border-radius:var(--r); padding:15px 17px; box-shadow:var(--shadow); min-width:0}
.painel h3{font-size:15px; font-weight:600; margin:0 0 2px}
.painel .nota{margin:0 0 12px; font-size:12px; color:var(--muted)}
.legenda{display:flex; flex-wrap:wrap; gap:4px 14px; font-size:11.5px; color:var(--ink-2); margin:0 0 10px}
.legenda i{display:inline-block; width:10px; height:10px; border-radius:2px; margin-right:5px; vertical-align:-1px}
.legenda i.ln{height:3px; border-radius:2px; vertical-align:3px; width:14px}
.legenda i.tr{background:repeating-linear-gradient(90deg,var(--l-dot) 0 4px,transparent 4px 7px)}

/* ranking */
.rk{display:flex; flex-direction:column; gap:7px; max-height:300px; overflow-y:auto; padding-right:6px; scrollbar-width:thin}
.rk-bar{font:inherit; color:inherit; background:none; border:0; padding:2px 0; cursor:pointer; text-align:left; width:100%; display:grid; grid-template-columns:92px 1fr 74px; gap:9px; align-items:center}
.rk-lbl{font-family:"JetBrains Mono",ui-monospace,monospace; font-size:12px; font-weight:600; color:var(--petrol); white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
.trilho{position:relative; height:16px; background:var(--surface-2); border-radius:4px; overflow:hidden}
.trilho > i{position:absolute; left:0; top:0; bottom:0; border-radius:0 4px 4px 0; min-width:2px}
.trilho .t-dot{background:var(--x-dot)}
.trilho .t-emp{background:var(--x-emp); top:3px; bottom:3px}
.trilho .t-pago{background:var(--x-pago); top:6px; bottom:6px}
.rk-n{font-family:"JetBrains Mono",ui-monospace,monospace; font-size:12px; text-align:right; color:var(--ink)}
.rk-bar:hover .rk-lbl{text-decoration:underline}
.rk-bar[aria-pressed="true"] .rk-lbl{color:var(--amber)}

/* categorias */
.cats{display:flex; flex-direction:column; gap:11px}
.cat-l{display:flex; justify-content:space-between; gap:10px; font-size:12.5px; margin-bottom:3px}
.cat-l b{font-weight:600}
.cat-l span{font-family:"JetBrains Mono",ui-monospace,monospace; color:var(--muted); white-space:nowrap}
.cat-row{font:inherit; color:inherit; background:none; border:0; padding:0; text-align:left; cursor:pointer; width:100%}
.cat-row[aria-pressed="true"] .cat-l b{color:var(--petrol); text-decoration:underline}

/* série */
.serie svg{width:100%; height:auto; display:block; overflow:visible}
.serie text{font-family:"JetBrains Mono",ui-monospace,monospace; font-size:10.5px; fill:var(--muted)}
.serie .grade{stroke:var(--line-2); stroke-width:1}
.serie .eixo{stroke:var(--line); stroke-width:1}
.vazio-serie{font-size:12.5px; color:var(--muted); margin:6px 0 0}

/* chips */
.chip{display:inline-flex; align-items:center; gap:5px; font-family:"JetBrains Mono",ui-monospace,monospace; font-size:10.5px; letter-spacing:.02em;
  padding:2px 7px; border-radius:5px; background:var(--surface-2); border:1px solid var(--line); color:var(--ink-2); white-space:nowrap}
.chip .dot{width:7px; height:7px; border-radius:50%; background:var(--c-out); flex:none}
.chip.Contábil .dot{background:var(--c-cont)} .chip.Financeiro .dot{background:var(--c-fin)} .chip.Misto .dot{background:var(--c-misto)}
.chip.ok{background:var(--ok-bg); color:var(--ok); border-color:transparent}
.chip.warn{background:var(--warn-bg); color:var(--warn); border-color:transparent}
.chip.bad{background:var(--bad-bg); color:var(--bad); border-color:transparent}
.chip.tipo{background:transparent; border-style:dashed}

/* identificação */
.idc{background:var(--surface); border:1px solid var(--line); border-radius:var(--r); padding:13px 14px; box-shadow:var(--shadow); display:flex; flex-direction:column; gap:4px}
.idc h3{font-size:14px}
.idc p{margin:0; font-size:12.5px; color:var(--ink-2)}
.idc .cob{font-family:"JetBrains Mono",ui-monospace,monospace; font-size:11.5px; color:var(--muted); margin-top:auto; padding-top:6px}
.idc .barra-cob{height:5px; background:var(--surface-2); border-radius:3px; overflow:hidden}
.idc .barra-cob i{display:block; height:100%; background:var(--petrol)}

/* tabela de fundos */
.ferramentas{display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin-bottom:12px}
.ferramentas input{flex:1 1 260px; min-width:0}
.ferramentas select{flex:0 0 auto; width:auto; max-width:100%}
.cont{margin-left:auto; font-family:"JetBrains Mono",ui-monospace,monospace; font-size:12px; color:var(--muted)}
.tabela{background:var(--surface); border:1px solid var(--line); border-radius:var(--r); overflow:hidden; box-shadow:var(--shadow)}
.cab,.linha{display:grid; grid-template-columns:170px minmax(0,1fr) 250px; gap:16px; padding:12px 18px; align-items:start}
.cab{padding-block:9px; background:var(--surface-2); border-bottom:1px solid var(--line); font-family:"JetBrains Mono",ui-monospace,monospace; font-size:10px; letter-spacing:.12em; text-transform:uppercase; color:var(--muted)}
.item{border-bottom:1px solid var(--line-2)}
.item:last-child{border-bottom:0}
.linha{cursor:pointer; width:100%; background:none; border:0; font:inherit; color:inherit; text-align:left}
.linha:hover{background:var(--surface-2)}
.item.aberto > .linha{background:var(--surface-2)}
.ls{font-family:"JetBrains Mono",ui-monospace,monospace; font-size:13.5px; font-weight:600; color:var(--petrol); display:flex; align-items:center; gap:6px}
.ls .seta{font-size:10px; color:var(--muted); transition:transform .15s}
.item.aberto .ls .seta{transform:rotate(90deg)}
.lm{margin-top:5px; display:flex; flex-wrap:wrap; gap:4px}
.ln{margin:0; font-size:14px; line-height:1.4}
.ids{margin:5px 0 0; display:flex; flex-wrap:wrap; gap:4px 12px; font-size:11.5px; color:var(--muted)}
.ids b{font-family:"JetBrains Mono",ui-monospace,monospace; font-weight:400; color:var(--ink-2)}
.ids .falta{color:var(--muted); font-style:italic}
.lv{font-size:12px}
.lv .trilho{height:12px; margin:2px 0 5px}
.lv .trilho .t-emp{top:2px; bottom:2px} .lv .trilho .t-pago{top:4px; bottom:4px}
.lv dl{margin:0; display:grid; grid-template-columns:auto 1fr; gap:0 10px}
.lv dt{color:var(--muted)}
.lv dd{margin:0; text-align:right; font-family:"JetBrains Mono",ui-monospace,monospace; color:var(--ink)}
.lv .nd{color:var(--muted); font-style:italic}
.vazio{padding:32px 20px; text-align:center; color:var(--muted)}
.mais{display:block; width:100%; padding:11px; font:inherit; font-size:13px; border:0; border-top:1px solid var(--line-2); background:var(--surface); color:var(--petrol); cursor:pointer}

/* detalhe */
.det{padding:4px 18px 20px; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px}
.det .bloco{background:var(--surface-2); border:1px solid var(--line-2); border-radius:8px; padding:12px 14px; min-width:0}
.det .bloco.largo{grid-column:1/-1}
.det h4{margin:0 0 8px; font-family:"JetBrains Mono",ui-monospace,monospace; font-size:10.5px; letter-spacing:.12em; text-transform:uppercase; color:var(--muted); font-weight:600}
.kv{display:grid; grid-template-columns:max-content minmax(0,1fr); gap:5px 12px; font-size:12.5px; margin:0}
.kv dt{color:var(--muted)}
.kv dd{margin:0; color:var(--ink)}
.rolagem{overflow-x:auto}
table.t{border-collapse:collapse; width:100%; font-size:12px}
table.t th{font-family:"JetBrains Mono",ui-monospace,monospace; font-size:10px; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); font-weight:600; text-align:right; padding:5px 8px; border-bottom:1px solid var(--line); white-space:nowrap}
table.t th:first-child,table.t td:first-child{text-align:left}
table.t td{padding:5px 8px; border-bottom:1px solid var(--line-2); text-align:right; font-family:"JetBrains Mono",ui-monospace,monospace; white-space:nowrap}
table.t td.txt{font-family:inherit; white-space:normal; text-align:left}
table.t tr:last-child td{border-bottom:0}
.tl{list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:8px}
.tl li{display:grid; grid-template-columns:52px 1fr; gap:10px; font-size:12.5px}
.tl .a{font-family:"JetBrains Mono",ui-monospace,monospace; color:var(--muted); font-size:11.5px}
.tl .c{display:flex; flex-wrap:wrap; gap:4px 8px; align-items:baseline}
.tl .c em{font-style:normal; color:var(--ink-2)}
.tl .r{display:block; color:var(--muted); font-size:11px}
.mini{display:flex; flex-direction:column; gap:6px}
.mini .ml{display:grid; grid-template-columns:minmax(0,1fr) 110px; gap:8px; font-size:12px; align-items:center}
.mini .ml span{overflow:hidden; text-overflow:ellipsis; white-space:nowrap}
.mini .ml .trilho{height:10px}

/* histórico de classificações */
.matriz th,.matriz td{vertical-align:top}
.matriz td{font-family:inherit; text-align:left; white-space:normal}
.matriz td .chip{margin:0 3px 3px 0}
.matriz td:first-child{font-family:"JetBrains Mono",ui-monospace,monospace; font-weight:600; color:var(--petrol); white-space:nowrap}
.linha-tempo{list-style:none; margin:0; padding:0; position:relative}
.linha-tempo::before{content:""; position:absolute; left:58px; top:6px; bottom:6px; width:1px; background:var(--line)}
.linha-tempo li{display:grid; grid-template-columns:50px 1fr; gap:22px; padding:9px 0; position:relative}
.linha-tempo li::before{content:""; position:absolute; left:54px; top:15px; width:9px; height:9px; border-radius:50%; background:var(--surface); border:2px solid var(--petrol)}
.linha-tempo li.Taxonomia::before{background:var(--petrol)}
.linha-tempo .ano{font-family:"JetBrains Mono",ui-monospace,monospace; font-size:12px; color:var(--ink-2); padding-top:3px; text-align:right}
.linha-tempo h3{font-size:14.5px; font-weight:600; margin:0}
.linha-tempo p{margin:3px 0 0; font-size:13px; color:var(--ink-2); max-width:78ch}
.linha-tempo .meta{display:flex; flex-wrap:wrap; gap:4px; margin-top:6px; align-items:center}
.linha-tempo .ref{font-size:11px; color:var(--muted); font-family:"JetBrains Mono",ui-monospace,monospace}
.filtro-tipos{display:flex; flex-wrap:wrap; gap:6px; margin-bottom:10px}
.filtro-tipos button{font:inherit; font-size:12px; padding:4px 10px; border-radius:20px; border:1px solid var(--line); background:var(--surface); color:var(--ink-2); cursor:pointer}
.filtro-tipos button[aria-pressed="true"]{background:var(--petrol); border-color:var(--petrol); color:var(--surface)}

/* verificação MTO */
.vt td.txt{min-width:240px}
.status{display:inline-flex; gap:5px; align-items:center}

#tip{position:fixed; z-index:20; pointer-events:none; background:var(--ink); color:var(--paper); font-size:12px; line-height:1.45; padding:7px 10px; border-radius:7px; max-width:280px; box-shadow:var(--shadow); opacity:0; transition:opacity .08s}
#tip.on{opacity:1}
#tip b{font-weight:600}
#tip .tn{font-family:"JetBrains Mono",ui-monospace,monospace}

footer{margin-top:44px; border-top:1px solid var(--line); background:var(--surface)}
.ft{padding-block:16px; font-size:12px; color:var(--muted); display:flex; flex-direction:column; gap:6px}
.ft p{margin:0; max-width:110ch}
code{font-family:"JetBrains Mono",ui-monospace,monospace; font-size:12px; background:var(--surface-2); border:1px solid var(--line-2); border-radius:5px; padding:1px 5px}

@media (prefers-reduced-motion:reduce){*{transition:none!important}}
@media (max-width:1020px){
  .grid3{grid-template-columns:1fr 1fr}
  .grid3 .serie{grid-column:1/-1}
  .grid4{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media (max-width:760px){
  .resumo{grid-template-columns:repeat(2,minmax(0,1fr))}
  .grid3,.grid2{grid-template-columns:1fr}
  .cab{display:none}
  .linha{grid-template-columns:1fr; gap:6px}
  .det{grid-template-columns:1fr; padding-inline:12px}
  .hd-dir{align-items:flex-start}
  .quando{text-align:left}
}
@media (max-width:520px){
  .wrap{padding-inline:16px}
  .hd h1{font-size:21px}
  .grid4{grid-template-columns:1fr}
  .tile b{font-size:18px}
  .rk-bar{grid-template-columns:78px 1fr 64px; gap:7px}
  .cont{margin-left:0; width:100%}
}
</style>
</head>
<body>

<header>
  <div class="wrap hd">
    <div>
      <p class="eyebrow">Orçamento da União · SIOP via orcamentoBR</p>
      <h1>Fundos Públicos da União</h1>
      <p>Dotação, empenho e pagamento de cada fundo, a combinação de códigos que o identifica (UO, fonte, UG e CNPJ) e o histórico de classificações registrado no ET nº 01/2026 da Conof/CD.</p>
    </div>
    <div class="hd-dir">
      <label class="ano-sel" for="ano">Exercício <select id="ano"></select></label>
      <p class="quando" id="quando">carregando…</p>
    </div>
  </div>
</header>

<main class="wrap">
  <div id="aviso"></div>

  <div class="resumo" id="resumo" aria-live="polite"></div>
  <div class="kpis" id="kpis" role="group" aria-label="Filtrar por categoria"></div>

  <section aria-labelledby="h-exec">
    <h2 id="h-exec">Execução orçamentária</h2>
    <p class="sub" id="sub-exec">Dotação atualizada (LOA + créditos), empenhado e pago no exercício. Clique num fundo para abrir o detalhe.</p>
